{
	"name": "never-fail",
	"version": "1.1.6",
	"description": "Run codes and ignore any error",
	"homepage": "https://github.com/cyberuni/never-fail",
	"bugs": {
		"url": "https://github.com/cyberuni/never-fail/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/never-fail.git",
		"directory": "packages/never-fail"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js",
		"require": "./cjs/index.js",
		"default": "./cjs/index.js"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.tsbuildinfo"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"dev": "vitest",
		"nuke": "pnpm clean && rimraf node_modules",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"verify": "npm-run-all -p build depcheck typecheck coverage -p size"
	},
	"dependencies": {
		"tersify": "^4.0.6"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^13.0.3",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"size-limit": "^13.0.3",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"typedoc": {
		"entryPoint": "./ts/index.ts",
		"readmeFile": "./README.md"
	}
}
